# Copy to .env and fill in the keys for the providers you use.
# The model string in configs/ picks the provider (LiteLLM convention):
#   anthropic/claude-sonnet-5-5   -> ANTHROPIC_API_KEY
#   openai/gpt-...                -> OPENAI_API_KEY
#   openrouter/<vendor>/<model>   -> OPENROUTER_API_KEY
#   ollama/<model>                -> no key, local server
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional: override the project root (defaults to the repo containing configs/default.yaml)
# ASKORACT_ROOT=
